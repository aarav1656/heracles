{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "paths": { "viem": ["./node_modules/viem"], "viem/*": ["./node_modules/viem/*"] }
  },
  "include": ["src", "tsdown.config.ts"]
}
